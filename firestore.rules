rules_version = '2';

// Reglas de seguridad de OnTicket
// Se publican con: firebase deploy --only firestore:rules
//
// Desde las Cloud Functions, todo lo que mueve dinero o da acceso al evento
// (compras, sillas vendidas, reservas, ingresos, facturas, correos) lo escribe
// SOLO el servidor. Desde la web o la app únicamente se puede leer lo propio.

service cloud.firestore {

  match /databases/{database}/documents {

    function logueado() {
      return request.auth != null;
    }

    function rol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role;
    }

    function esAdmin() {
      return logueado() && rol() == 'admin';
    }

    function esStaff() {
      return logueado() && rol() in ['admin', 'taquilla'];
    }

    // Perfil: cada quien ve y edita el suyo; nadie se puede asignar un rol solo
    match /usuarios/{uid} {
      allow read: if logueado() && (request.auth.uid == uid || esAdmin());
      allow create: if logueado() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if logueado() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
    }

    // Eventos: todos los ven, solo el admin los crea o edita
    match /eventos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Compras: cada usuario ve las suyas (para ver sus boletas) y el admin todas.
    // Crearlas, anularlas y registrar ingresos solo lo hace el servidor.
    match /compras/{codigo} {
      allow read: if logueado() && (resource.data.uid == request.auth.uid || esAdmin());
      allow write: if false;
    }

    // Sillas vendidas y apartadas: todos las ven (para pintar el plano)
    match /ventas/{eventoId} {
      allow read: if true;
      allow write: if false;
    }

    match /reservas/{eventoId} {
      allow read: if true;
      allow write: if false;
    }

    // Consecutivo de facturas y cola de correos: solo el servidor
    match /contadores/{id} {
      allow read, write: if false;
    }

    match /correos/{id} {
      allow read, write: if false;
    }
  }
}
