rules_version = '2';

// Reglas de seguridad de OnTicket
// Se publican con: firebase deploy --only firestore:rules
//
// Desde las Cloud Functions, todo lo que mueve dinero o da acceso al evento
// (compras, sillas vendidas, reservas, ingresos, facturas, correos) lo escribe
// SOLO el servidor. Desde la web o la app únicamente se puede leer lo propio.

service cloud.firestore {

  match /databases/{database}/documents {

    function logueado() {
      return request.auth != null;
    }

    function rol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role;
    }

    function esAdmin() {
      return logueado() && rol() == 'admin';
    }

    function esPromotor() {
      return logueado() && rol() == 'promotor';
    }

    // lo que un promotor envía: queda pendiente de aprobación, a su nombre y sin ventas de demostración
    function eventoDePromotor() {
      return request.resource.data.promotorUid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.get('demo', false) == false
        && request.resource.data.get('destacado', false) == false;
    }

    function esStaff() {
      return logueado() && rol() in ['admin', 'taquilla'];
    }

    // Perfil: cada quien ve y edita el suyo; nadie se puede asignar un rol solo
    match /usuarios/{uid} {
      allow read: if logueado() && (request.auth.uid == uid || esAdmin());
      allow create: if logueado() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if logueado() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
    }

    // Eventos: todos los ven. El admin hace todo; el promotor solo crea los suyos
    // y los edita o borra mientras no estén aprobados.
    match /eventos/{id} {
      allow read: if true;
      allow write: if esAdmin();
      allow create: if esPromotor() && eventoDePromotor();
      allow update: if esPromotor() && resource.data.promotorUid == request.auth.uid
        && resource.data.estado in ['pendiente', 'rechazado'] && eventoDePromotor();
      allow delete: if esPromotor() && resource.data.promotorUid == request.auth.uid
        && resource.data.estado != 'aprobado';
    }

    // Imagen guía del plano (editor): solo su dueño y el admin
    match /fondosPlano/{id} {
      allow read, delete: if esAdmin() || (esPromotor() && resource.data.promotorUid == request.auth.uid);
      allow create, update: if esAdmin() || (esPromotor() && request.resource.data.promotorUid == request.auth.uid);
    }

    // Compras: cada usuario ve las suyas (para ver sus boletas) y el admin todas.
    // Crearlas, anularlas y registrar ingresos solo lo hace el servidor.
    match /compras/{codigo} {
      allow read: if logueado() && (resource.data.uid == request.auth.uid || esAdmin());
      allow write: if false;
    }

    // Pagos en Wompi: cada quien ve el estado de los suyos; solo el servidor escribe
    match /pagos/{referencia} {
      allow read: if logueado() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Sillas vendidas y apartadas: todos las ven (para pintar el plano)
    match /ventas/{eventoId} {
      allow read: if true;
      allow write: if false;
    }

    match /reservas/{eventoId} {
      allow read: if true;
      allow write: if false;
    }

    // Consecutivo de facturas y cola de correos: solo el servidor
    match /contadores/{id} {
      allow read, write: if false;
    }

    match /correos/{id} {
      allow read, write: if false;
    }
  }
}
